            },
            {
              "sid": "s3",
              "kind": "write_shared",
              "resource": "main::c",
              "expr": "prev + 1"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ]
        }
      ]
    }
