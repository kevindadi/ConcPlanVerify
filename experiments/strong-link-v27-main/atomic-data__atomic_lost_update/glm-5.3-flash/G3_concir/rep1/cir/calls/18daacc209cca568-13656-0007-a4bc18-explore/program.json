          "mode": "Sync"
        },
        {
          "name": "c",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        }
      ],
      "protection": [
        {
          "var": "c",
          "lock": "m"
        }
      ],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::w1",
                "main::w2"
              ]
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "w1",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "call",
              "func": "main::rmw_add"
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "w2",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "call",
              "func": "main::rmw_add"
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "rmw_add",
