{
  "program": "bare_wait",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "ready",
          "mtx",
          "cv"
        ],
        "functions": [
          "main",
          "waiter",
          "notifier"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "ready",
          "kind": "var",
          "type": "Var",
          "base": "Bool",
          "init": false
        },
        {
          "name": "mtx",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "cv",
          "kind": "sync",
          "type": "Condvar",
          "mode": "Sync"
        }
      ],
      "protection": [
        {
          "var": "main::ready",
          "lock": "main::mtx"
        }
      ],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::waiter",
                "main::notifier"
              ]
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "waiter",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::mtx"
            },
            {
              "sid": "s2",
              "kind": "branch",
              "cond": "ready == true",
              "then": "s5",
              "else": "s3"
            },
            {
              "sid": "s3",
              "kind": "condvar_wait",
              "condvar": "main::cv",
              "lock": "main::mtx"
            },
            {
              "sid": "s4",
              "kind": "goto",
              "target": "s2"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "main::mtx"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
          "name": "notifier",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::mtx"
            },
            {
              "sid": "s2",
              "kind": "write_shared",
              "resource": "main::ready",
              "expr": "true"
            },
            {
              "sid": "s3",
              "kind": "condvar_notify",
              "condvar": "main::cv"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::mtx"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
