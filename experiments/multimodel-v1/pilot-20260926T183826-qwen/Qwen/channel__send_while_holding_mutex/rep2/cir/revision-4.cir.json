{
  "program": "sender_receiver_lock_channel",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "m",
          "ch1",
          "ch2"
        ],
        "functions": [
          "main",
          "s",
          "r"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "m",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "ch1",
          "kind": "sync",
          "type": "Channel",
          "base": "Int",
          "capacity": 0,
          "mode": "Sync"
        },
        {
          "name": "ch2",
          "kind": "sync",
          "type": "Channel",
          "base": "Int",
          "capacity": 0,
          "mode": "Sync"
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::s",
                "main::r"
              ]
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "s",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "channel_send",
              "resource": "main::ch1",
              "value": "1"
            },
            {
              "sid": "s3",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s4",
              "kind": "channel_recv",
              "resource": "main::ch2",
              "dst": "done"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ],
          "locals": [
            {
              "name": "done",
              "type": "Int"
            }
          ]
        },
        {
          "name": "r",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "channel_recv",
              "resource": "main::ch1",
              "dst": "val"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s3",
              "kind": "channel_send",
              "resource": "main::ch2",
              "value": "1"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ],
          "locals": [
            {
              "name": "val",
              "type": "Int"
            }
          ]
        }
      ]
    }
  ]
}
