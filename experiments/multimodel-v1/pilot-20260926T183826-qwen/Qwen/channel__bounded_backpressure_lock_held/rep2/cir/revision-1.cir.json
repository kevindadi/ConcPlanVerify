{
  "program": "bounded_channel_sender_receiver",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "m",
          "ch"
        ],
        "functions": [
          "main",
          "sender",
          "receiver"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "m",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "ch",
          "kind": "sync",
          "type": "Channel",
          "base": "Int",
          "capacity": 1,
          "mode": "Sync"
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::sender",
                "main::receiver"
              ]
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "sender",
          "kind": "normal",
          "form": "closure",
          "locals": [
            {
              "name": "done",
              "type": "Int",
              "modeled": true,
              "init": 0
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "call",
              "func": "main::channel_send",
              "args": [
                "main::ch",
                "1"
              ]
            },
            {
              "sid": "s3",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s4",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s5",
              "kind": "call",
              "func": "main::channel_send",
              "args": [
                "main::ch",
                "2"
              ]
            },
            {
              "sid": "s6",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s7",
              "kind": "assign_local",
              "target": "done",
              "expr": "1"
            },
            {
              "sid": "s8",
              "kind": "return"
            }
          ]
        },
        {
          "name": "receiver",
          "kind": "normal",
          "form": "closure",
          "locals": [
            {
              "name": "v1",
              "type": "Int",
              "modeled": true,
              "init": 0
            },
            {
              "name": "v2",
              "type": "Int",
              "modeled": true,
              "init": 0
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "call",
              "func": "main::channel_recv",
              "args": [
                "main::ch"
              ],
              "dst": "v1"
            },
            {
              "sid": "s3",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s4",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s5",
              "kind": "call",
              "func": "main::channel_recv",
              "args": [
                "main::ch"
              ],
              "dst": "v2"
            },
            {
              "sid": "s6",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s7",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
