{
  "program": "one_slot_channel_ping_pong",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "m",
          "ch"
        ],
        "functions": [
          "main",
          "sender",
          "receiver"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "m",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "ch",
          "kind": "sync",
          "type": "Channel",
          "mode": "Sync",
          "base": "Int",
          "capacity": 1
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "body": [
            {
              "sid": "s1",
              "kind": "spawn",
              "func": "main::sender",
              "handle": "hs"
            },
            {
              "sid": "s2",
              "kind": "spawn",
              "func": "main::receiver",
              "handle": "hr"
            },
            {
              "sid": "s3",
              "kind": "join",
              "handle": "hs"
            },
            {
              "sid": "s4",
              "kind": "join",
              "handle": "hr"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ]
        },
        {
          "name": "sender",
          "kind": "normal",
          "form": "closure",
          "locals": [
            {
              "name": "v1",
              "type": "Int",
              "modeled": true,
              "init": 1
            },
            {
              "name": "v2",
              "type": "Int",
              "modeled": true,
              "init": 2
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s3",
              "kind": "channel_send",
              "resource": "main::ch",
              "expr": "v1"
            },
            {
              "sid": "s4",
              "kind": "channel_send",
              "resource": "main::ch",
              "expr": "v2"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ]
        },
        {
          "name": "receiver",
          "kind": "normal",
          "form": "closure",
          "locals": [
            {
              "name": "r1",
              "type": "Int",
              "modeled": true,
              "init": 0
            },
            {
              "name": "r2",
              "type": "Int",
              "modeled": true,
              "init": 0
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s3",
              "kind": "channel_recv",
              "resource": "main::ch",
              "dst": "r1"
            },
            {
              "sid": "s4",
              "kind": "channel_recv",
              "resource": "main::ch",
              "dst": "r2"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
