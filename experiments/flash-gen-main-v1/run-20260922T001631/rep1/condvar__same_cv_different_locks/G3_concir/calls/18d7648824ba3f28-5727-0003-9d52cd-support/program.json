{
  "program": "concir_modular",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "cv",
          "m1",
          "m2",
          "announced",
          "done"
        ],
        "functions": [
          "main",
          "waiter1",
          "waiter2",
          "notifier"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "cv",
          "kind": "sync",
          "type": "Condvar",
          "mode": "Sync"
        },
        {
          "name": "m1",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "m2",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "announced",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        },
        {
          "name": "done",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        }
      ],
      "protection": [
        {
          "var": "announced",
          "lock": "m1"
        },
        {
          "var": "done",
          "lock": "m2"
        }
      ],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::waiter1",
                "main::waiter2",
                "main::notifier"
              ]
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "waiter1",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m1"
            },
            {
              "sid": "s2",
              "kind": "read_shared",
              "resource": "main::announced",
              "dst": "a"
            },
            {
              "sid": "s3",
              "kind": "assign_local",
              "target": "a2",
              "expr": "a + 1"
            },
            {
              "sid": "s4",
              "kind": "write_shared",
              "resource": "main::announced",
              "expr": "a2"
            },
            {
              "sid": "s5",
              "kind": "condvar_wait",
              "condvar": "main::cv",
              "lock": "main::m1"
            },
            {
              "sid": "s6",
              "kind": "mutex_unlock",
              "resource": "main::m1"
            },
            {
              "sid": "s7",
              "kind": "mutex_lock",
              "resource": "main::m2"
            },
            {
              "sid": "s8",
              "kind": "read_shared",
              "resource": "main::done",
              "dst": "d"
            },
            {
              "sid": "s9",
              "kind": "assign_local",
              "target": "d2",
              "expr": "d + 1"
            },
            {
              "sid": "s10",
              "kind": "write_shared",
              "resource": "main::done",
              "expr": "d2"
            },
            {
              "sid": "s11",
              "kind": "mutex_unlock",
              "resource": "main::m2"
            },
            {
              "sid": "s12",
              "kind": "return"
            }
          ],
          "locals": [
            {
              "name": "a",
              "type": "Int"
            },
            {
              "name": "a2",
              "type": "Int"
            },
            {
              "name": "d",
              "type": "Int"
            },
            {
              "name": "d2",
              "type": "Int"
            }
          ]
        },
        {
          "name": "waiter2",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m2"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "main::m1"
            },
            {
              "sid": "s3",
              "kind": "read_shared",
              "resource": "main::announced",
              "dst": "a"
            },
            {
              "sid": "s4",
              "kind": "assign_local",
              "target": "a2",
              "expr": "a + 1"
            },
            {
              "sid": "s5",
              "kind": "write_shared",
              "resource": "main::announced",
              "expr": "a2"
            },
            {
              "sid": "s6",
              "kind": "mutex_unlock",
              "resource": "main::m1"
            },
            {
              "sid": "s7",
              "kind": "condvar_wait",
              "condvar": "main::cv",
              "lock": "main::m2"
            },
            {
              "sid": "s8",
              "kind": "mutex_unlock",
              "resource": "main::m2"
            },
            {
              "sid": "s9",
              "kind": "mutex_lock",
              "resource": "main::m2"
            },
            {
              "sid": "s10",
              "kind": "read_shared",
              "resource": "main::done",
              "dst": "d"
            },
            {
              "sid": "s11",
              "kind": "assign_local",
              "target": "d2",
              "expr": "d + 1"
            },
            {
              "sid": "s12",
              "kind": "write_shared",
              "resource": "main::done",
              "expr": "d2"
            },
            {
              "sid": "s13",
              "kind": "mutex_unlock",
              "resource": "main::m2"
            },
            {
              "sid": "s14",
              "kind": "return"
            }
          ],
          "locals": [
            {
              "name": "a",
              "type": "Int"
            },
            {
              "name": "a2",
              "type": "Int"
            },
            {
              "name": "d",
              "type": "Int"
            },
            {
              "name": "d2",
              "type": "Int"
            }
          ]
        },
        {
          "name": "notifier",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m1"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "main::m2"
            },
            {
              "sid": "s3",
              "kind": "read_shared",
              "resource": "main::announced",
              "dst": "a"
            },
            {
              "sid": "s4",
              "kind": "branch",
              "cond": "a == 2",
              "then": "s6",
              "else": "s5"
            },
            {
              "sid": "s5",
              "kind": "goto",
              "target": "s3"
            },
            {
              "sid": "s6",
              "kind": "condvar_notify_all",
              "condvar": "main::cv"
            },
            {
              "sid": "s7",
              "kind": "mutex_unlock",
              "resource": "main::m2"
            },
            {
              "sid": "s8",
              "kind": "mutex_unlock",
              "resource": "main::m1"
            },
            {
              "sid": "s9",
              "kind": "return"
            }
          ],
          "locals": [
            {
              "name": "a",
              "type": "Int"
            }
          ]
        }
      ]
    }
  ]
}
