{
  "program": "waiters_notifier",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "m",
          "cv",
          "ready_count"
        ],
        "functions": [
          "main",
          "waiter",
          "notifier"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "m",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "cv",
          "kind": "sync",
          "type": "Condvar",
          "mode": "Sync"
        },
        {
          "name": "ready_count",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        }
      ],
      "protection": [
        {
          "var": "ready_count",
          "lock": "m"
        }
      ],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::waiter",
                "main::waiter",
                "main::notifier"
              ]
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "waiter",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "read_shared",
              "resource": "main::ready_count",
              "dst": "rc"
            },
            {
              "sid": "s3",
              "kind": "assign_local",
              "target": "rc2",
              "expr": "rc + 1"
            },
            {
              "sid": "s4",
              "kind": "write_shared",
              "resource": "main::ready_count",
              "expr": "rc2"
            },
            {
              "sid": "s5",
              "kind": "branch",
              "cond": "rc2 == 2",
              "then": "s6",
              "else": "s7"
            },
            {
              "sid": "s6",
              "kind": "condvar_notify_all",
              "condvar": "main::cv"
            },
            {
              "sid": "s7",
              "kind": "goto",
              "target": "s8"
            },
            {
              "sid": "s8",
              "kind": "branch",
              "cond": "rc2 == 2",
              "then": "s10",
              "else": "s9"
            },
            {
              "sid": "s9",
              "kind": "condvar_wait",
              "condvar": "main::cv",
              "lock": "main::m"
            },
            {
              "sid": "s10",
              "kind": "goto",
              "target": "s8"
            },
            {
              "sid": "s11",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s12",
              "kind": "return"
            }
          ],
          "locals": [
            {
              "name": "rc",
              "type": "Int"
            },
            {
              "name": "rc2",
              "type": "Int"
            }
          ]
        },
        {
          "name": "notifier",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "goto",
              "target": "s3"
            },
            {
              "sid": "s3",
              "kind": "read_shared",
              "resource": "main::ready_count",
              "dst": "rc"
            },
            {
              "sid": "s4",
              "kind": "branch",
              "cond": "rc == 2",
              "then": "s5",
              "else": "s6"
            },
            {
              "sid": "s5",
              "kind": "goto",
              "target": "s7"
            },
            {
              "sid": "s6",
              "kind": "condvar_wait",
              "condvar": "main::cv",
              "lock": "main::m"
            },
            {
              "sid": "s7",
              "kind": "goto",
              "target": "s3"
            },
            {
              "sid": "s8",
              "kind": "condvar_notify_all",
              "condvar": "main::cv"
            },
            {
              "sid": "s9",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s10",
              "kind": "return"
            }
          ],
          "locals": [
            {
              "name": "rc",
              "type": "Int"
            }
          ]
        }
      ]
    }
  ]
}
