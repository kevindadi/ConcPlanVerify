{
  "program": "concir_mod",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "ch",
          "m"
        ],
        "functions": [
          "main",
          "sender",
          "receiver"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "ch",
          "kind": "sync",
          "type": "Channel",
          "mode": "Sync",
          "base": "Int",
          "capacity": 1
        },
        {
          "name": "m",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::sender",
                "main::receiver"
              ]
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "sender",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "channel_send",
              "channel": "main::ch",
              "value": "1"
            },
            {
              "sid": "s2",
              "kind": "channel_send",
              "channel": "main::ch",
              "value": "2"
            },
            {
              "sid": "s3",
              "kind": "return"
            }
          ]
        },
        {
          "name": "receiver",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "channel_recv",
              "channel": "main::ch",
              "dst": "x"
            },
            {
              "sid": "s2",
              "kind": "channel_recv",
              "channel": "main::ch",
              "dst": "y"
            },
            {
              "sid": "s3",
              "kind": "return"
            }
          ],
          "locals": [
            {
              "name": "x",
              "type": "Int"
            },
            {
              "name": "y",
              "type": "Int"
            }
          ]
        }
      ]
    }
  ]
}
