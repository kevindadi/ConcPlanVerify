{
  "program": "two_module_lock",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "a"
        ],
        "functions": [
          "main",
          "t1"
        ]
      },
      "requires": {
        "resources": [
          "m2"
        ],
        "functions": [
          "t2"
        ]
      },
      "resources": [
        {
          "name": "a",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "spawn",
              "func": "main::t1",
              "handle": "h1"
            },
            {
              "sid": "s2",
              "kind": "spawn",
              "func": "other::t2",
              "handle": "h2"
            },
            {
              "sid": "s3",
              "kind": "join",
              "handle": "h1"
            },
            {
              "sid": "s4",
              "kind": "join",
              "handle": "h2"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ]
        },
        {
          "name": "t1",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::a"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "other::m2"
            },
            {
              "sid": "s3",
              "kind": "mutex_unlock",
              "resource": "other::m2"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::a"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ]
        }
      ]
    },
    {
      "name": "other",
      "provides": {
        "resources": [
          "b"
        ],
        "functions": [
          "t2"
        ]
      },
      "requires": {
        "resources": [
          "m1"
        ],
        "functions": [
          "t1"
        ]
      },
      "resources": [
        {
          "name": "b",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "t2",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m1"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "other::b"
            },
            {
              "sid": "s3",
              "kind": "mutex_unlock",
              "resource": "other::b"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::m1"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
