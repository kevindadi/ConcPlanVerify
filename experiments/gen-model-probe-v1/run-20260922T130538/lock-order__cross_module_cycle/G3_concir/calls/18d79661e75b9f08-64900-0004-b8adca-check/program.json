{
  "program": "two_module_ordered_locks",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "a",
          "done"
        ],
        "functions": [
          "main",
          "t1"
        ]
      },
      "requires": {
        "resources": [
          "other::r2"
        ],
        "functions": [
          "other::t2"
        ]
      },
      "resources": [
        {
          "name": "a",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "done",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "spawn",
              "func": "main::t1",
              "handle": "h1"
            },
            {
              "sid": "s2",
              "kind": "spawn",
              "func": "other::t2",
              "handle": "h2"
            },
            {
              "sid": "s3",
              "kind": "join",
              "handle": "h1"
            },
            {
              "sid": "s4",
              "kind": "join",
              "handle": "h2"
            },
            {
              "sid": "s5",
              "kind": "write_shared",
              "resource": "main::done",
              "expr": "1"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
          "name": "t1",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::a"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "other::r2"
            },
            {
              "sid": "s3",
              "kind": "nop"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "other::r2"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "main::a"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        }
      ]
    },
    {
      "name": "other",
      "provides": {
        "resources": [
          "b"
        ],
        "functions": [
          "t2"
        ]
      },
      "requires": {
        "resources": [
          "main::r1"
        ],
        "functions": []
      },
      "resources": [
        {
          "name": "b",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "t2",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::r1"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "other::b"
            },
            {
              "sid": "s3",
              "kind": "nop"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "other::b"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "main::r1"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
