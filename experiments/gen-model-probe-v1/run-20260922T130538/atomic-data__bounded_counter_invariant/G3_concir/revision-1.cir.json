{
  "program": "supervised_counter",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "c",
          "m",
          "stdout"
        ],
        "functions": [
          "main",
          "w1"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "c",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        },
        {
          "name": "m",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "stdout",
          "kind": "var",
          "type": "Var",
          "base": "String",
          "init": ""
        }
      ],
      "protection": [
        {
          "var": "c",
          "lock": "m"
        }
      ],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "spawn",
              "func": "main::w1",
              "handle": "h1"
            },
            {
              "sid": "s2",
              "kind": "spawn",
              "func": "main::w1",
              "handle": "h2"
            },
            {
              "sid": "s3",
              "kind": "join",
              "handle": "h1"
            },
            {
              "sid": "s4",
              "kind": "join",
              "handle": "h2"
            },
            {
              "sid": "s5",
              "kind": "write_shared",
              "resource": "main::stdout",
              "expr": "\"DONE done=1\""
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
          "name": "w1",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "read_shared",
              "resource": "main::c",
              "dst": "c"
            },
            {
              "sid": "s3",
              "kind": "write_shared",
              "resource": "main::c",
              "expr": "c + 1"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ],
          "locals": [
            {
              "name": "c",
              "type": "Int"
            }
          ]
        }
      ]
    }
  ]
}
