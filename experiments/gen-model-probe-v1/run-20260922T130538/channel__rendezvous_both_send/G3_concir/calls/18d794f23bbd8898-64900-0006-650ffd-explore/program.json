{
  "program": "rendezvous",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "ch",
          "done"
        ],
        "functions": [
          "main",
          "sender",
          "receiver"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "ch",
          "kind": "sync",
          "type": "Channel",
          "mode": "Sync",
          "base": "Int",
          "capacity": 0
        },
        {
          "name": "done",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "spawn",
              "func": "main::sender",
              "handle": "h_sender"
            },
            {
              "sid": "s2",
              "kind": "spawn",
              "func": "main::receiver",
              "handle": "h_receiver"
            },
            {
              "sid": "s3",
              "kind": "join",
              "handle": "h_sender"
            },
            {
              "sid": "s4",
              "kind": "join",
              "handle": "h_receiver"
            },
            {
              "sid": "s5",
              "kind": "write_shared",
              "resource": "main::done",
              "expr": "1"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
          "name": "sender",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "channel_send",
              "channel": "main::ch",
              "value": "1"
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "receiver",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "channel_recv",
              "channel": "main::ch",
              "dst": "v"
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ],
          "locals": [
            {
              "name": "v",
              "type": "Int"
            }
          ]
        }
      ]
    }
  ]
}
