{
  "program": "send_recv_lock",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "ch",
          "m",
          "done"
        ],
        "functions": [
          "main",
          "sender",
          "receiver"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "ch",
          "kind": "sync",
          "type": "Channel",
          "mode": "Sync",
          "base": "Int",
          "capacity": 1
        },
        {
          "name": "m",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "done",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::sender",
                "main::receiver"
              ]
            },
            {
              "sid": "s2",
              "kind": "write_shared",
              "resource": "main::done",
              "expr": "1"
            },
            {
              "sid": "s3",
              "kind": "read_shared",
              "resource": "main::done",
              "dst": "out"
            },
            {
              "sid": "s4",
              "kind": "return"
            }
          ],
          "locals": [
            {
              "name": "out",
              "type": "Int"
            }
          ]
        },
        {
          "name": "sender",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s3",
              "kind": "channel_send",
              "channel": "main::ch",
              "value": "1"
            },
            {
              "sid": "s4",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s6",
              "kind": "channel_send",
              "channel": "main::ch",
              "value": "2"
            },
            {
              "sid": "s7",
              "kind": "return"
            }
          ]
        },
        {
          "name": "receiver",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s3",
              "kind": "channel_recv",
              "channel": "main::ch",
              "dst": "first"
            },
            {
              "sid": "s4",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s6",
              "kind": "channel_recv",
              "channel": "main::ch",
              "dst": "second"
            },
            {
              "sid": "s7",
              "kind": "return"
            }
          ],
          "locals": [
            {
              "name": "first",
              "type": "Int"
            },
            {
              "name": "second",
              "type": "Int"
            }
          ]
        }
      ]
    }
  ]
}
