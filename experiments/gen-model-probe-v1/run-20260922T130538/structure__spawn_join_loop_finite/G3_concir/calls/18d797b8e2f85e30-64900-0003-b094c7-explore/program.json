{
  "program": "spawn_join_cycle",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "done",
          "output"
        ],
        "functions": [
          "main",
          "worker"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "done",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        },
        {
          "name": "output",
          "kind": "var",
          "type": "Var",
          "base": "String",
          "init": ""
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "assign_local",
              "target": "i",
              "expr": "0"
            },
            {
              "sid": "s2",
              "kind": "branch",
              "cond": "i < 3",
              "then": "s3",
              "else": "s7"
            },
            {
              "sid": "s3",
              "kind": "spawn",
              "func": "main::worker",
              "handle": "h"
            },
            {
              "sid": "s4",
              "kind": "join",
              "handle": "h"
            },
            {
              "sid": "s5",
              "kind": "assign_local",
              "target": "i",
              "expr": "i + 1"
            },
            {
              "sid": "s6",
              "kind": "goto",
              "target": "s2"
            },
            {
              "sid": "s7",
              "kind": "write_shared",
              "resource": "main::done",
              "expr": "1"
            },
            {
              "sid": "s8",
              "kind": "write_shared",
              "resource": "main::output",
              "expr": "\"DONE done=1\""
            },
            {
              "sid": "s9",
              "kind": "return"
            }
          ],
          "locals": [
            {
              "name": "i",
              "type": "Int"
            }
          ]
        },
        {
          "name": "worker",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "nop"
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
