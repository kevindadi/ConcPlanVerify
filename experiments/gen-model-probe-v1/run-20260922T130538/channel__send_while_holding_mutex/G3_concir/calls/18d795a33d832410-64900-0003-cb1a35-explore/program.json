{
  "program": "rendezvous_exchange",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "lock",
          "ch1",
          "done"
        ],
        "functions": [
          "main",
          "s",
          "r"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "lock",
          "kind": "sync",
          "mode": "Sync",
          "type": "Mutex"
        },
        {
          "name": "ch1",
          "kind": "sync",
          "mode": "Sync",
          "type": "Channel",
          "base": "Int",
          "capacity": 0
        },
        {
          "name": "done",
          "kind": "var",
          "type": "Var",
          "base": "Bool",
          "init": false
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::s",
                "main::r"
              ]
            },
            {
              "sid": "s2",
              "kind": "write_shared",
              "resource": "main::done",
              "expr": "true"
            },
            {
              "sid": "s3",
              "kind": "return"
            }
          ]
        },
        {
          "name": "s",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::lock"
            },
            {
              "sid": "s2",
              "kind": "mutex_unlock",
              "resource": "main::lock"
            },
            {
              "sid": "s3",
              "kind": "channel_send",
              "channel": "main::ch1",
              "value": "42"
            },
            {
              "sid": "s4",
              "kind": "return"
            }
          ]
        },
        {
          "name": "r",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::lock"
            },
            {
              "sid": "s2",
              "kind": "mutex_unlock",
              "resource": "main::lock"
            },
            {
              "sid": "s3",
              "kind": "channel_recv",
              "channel": "main::ch1",
              "dst": "v"
            },
            {
              "sid": "s4",
              "kind": "return"
            }
          ],
          "locals": [
            {
              "name": "v",
              "type": "Int"
            }
          ]
        }
      ]
    }
  ]
}
