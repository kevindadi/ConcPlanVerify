{
  "program": "counter_overflow_safety",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "m",
          "c"
        ],
        "functions": [
          "main",
          "w1",
          "w2"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "m",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "c",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        }
      ],
      "protection": [
        {
          "var": "c",
          "lock": "m"
        }
      ],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::w1",
                "main::w2"
              ]
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "w1",
          "kind": "normal",
          "form": "closure",
          "locals": [
            {
              "name": "cur",
              "type": "Int",
              "modeled": true,
              "init": 0
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "read_shared",
              "resource": "main::c",
              "dst": "cur"
            },
            {
              "sid": "s3",
              "kind": "if",
              "cond": "cur + 1 <= 1",
              "then": [
                {
                  "sid": "s4",
                  "kind": "write_shared",
                  "resource": "main::c",
                  "expr": "cur + 1"
                }
              ]
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
          "name": "w2",
          "kind": "normal",
          "form": "closure",
          "locals": [
            {
              "name": "cur",
              "type": "Int",
              "modeled": true,
              "init": 0
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "read_shared",
              "resource": "main::c",
              "dst": "cur"
            },
            {
              "sid": "s3",
              "kind": "if",
              "cond": "cur + 1 <= 1",
              "then": [
                {
                  "sid": "s4",
                  "kind": "write_shared",
                  "resource": "main::c",
                  "expr": "cur + 1"
                }
              ]
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
