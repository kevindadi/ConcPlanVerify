{
  "program": "condvar_wait_ready_flag",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "m",
          "cv",
          "ready"
        ],
        "functions": [
          "main",
          "waiter",
          "notifier",
          "wait_until_ready"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "m",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "cv",
          "kind": "sync",
          "type": "Condvar",
          "mode": "Sync"
        },
        {
          "name": "ready",
          "kind": "var",
          "type": "Var",
          "base": "Bool",
          "init": false
        }
      ],
      "protection": [
        {
          "var": "ready",
          "lock": "m"
        }
      ],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::waiter",
                "main::notifier"
              ]
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "waiter",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "call",
              "func": "main::wait_until_ready"
            },
            {
              "sid": "s3",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s4",
              "kind": "return"
            }
          ]
        },
        {
          "name": "wait_until_ready",
          "kind": "normal",
          "form": "closure",
          "locals": [
            {
              "name": "r",
              "type": "Bool",
              "modeled": true,
              "init": false
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "assign_local",
              "target": "r",
              "expr": "ready"
            },
            {
              "sid": "s2",
              "kind": "call",
              "func": "main::wait_if_not_ready",
              "args": [
                "r"
              ]
            },
            {
              "sid": "s3",
              "kind": "assign_local",
              "target": "r",
              "expr": "ready"
            },
            {
              "sid": "s4",
              "kind": "call",
              "func": "main::wait_until_ready_cont",
              "args": [
                "r"
              ]
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ]
        },
        {
          "name": "wait_if_not_ready",
          "kind": "normal",
          "form": "closure",
          "params": [
            {
              "name": "r",
              "type": "Bool",
              "modeled": true
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "condvar_wait",
              "condvar": "main::cv",
              "lock": "main::m",
              "cond": "!r"
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "wait_until_ready_cont",
          "kind": "normal",
          "form": "closure",
          "params": [
            {
              "name": "r",
              "type": "Bool",
              "modeled": true
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "call",
              "func": "main::wait_until_ready",
              "cond": "!r"
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "notifier",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "write_shared",
              "resource": "main::ready",
              "expr": "true"
            },
            {
              "sid": "s3",
              "kind": "condvar_notify",
              "condvar": "main::cv"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
