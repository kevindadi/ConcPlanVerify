{
  "program": "nested_scope_lock_order",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "a",
          "b"
        ],
        "functions": [
          "main",
          "outer",
          "x1",
          "x2",
          "print_done"
        ]
      },
      "requires": {
        "resources": [],
        "functions": [
          "stdlib::print"
        ]
      },
      "resources": [
        {
          "name": "a",
          "kind": "sync",
          "mode": "Sync",
          "type": "Mutex"
        },
        {
          "name": "b",
          "kind": "sync",
          "mode": "Sync",
          "type": "Mutex"
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "spawn",
              "func": "main::outer",
              "handle": "h_outer",
              "args": "[]"
            },
            {
              "sid": "s2",
              "kind": "join",
              "handle": "h_outer"
            },
            {
              "sid": "s3",
              "kind": "call",
              "func": "main::print_done",
              "args": "[]"
            },
            {
              "sid": "s4",
              "kind": "return"
            }
          ]
        },
        {
          "name": "outer",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::x1",
                "main::x2"
              ]
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        },
        {
          "name": "x1",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::a"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "main::b"
            },
            {
              "sid": "s3",
              "kind": "nop"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::b"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "main::a"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
          "name": "x2",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::a"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "main::b"
            },
            {
              "sid": "s3",
              "kind": "nop"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::b"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "main::a"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
          "name": "print_done",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "call",
              "func": "stdlib::print",
              "args": "[\"DONE done=1\"]"
            },
            {
              "sid": "s2",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
