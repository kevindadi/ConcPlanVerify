{
  "program": "counter_overflow_safety",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "m",
          "c"
        ],
        "functions": [
          "main",
          "w1",
          "w2"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "m",
          "kind": "sync",
          "mode": "Sync",
          "type": "Mutex"
        },
        {
          "name": "c",
          "kind": "var",
          "type": "Var",
          "base": {
            "Int": {
              "min": 0,
              "max": 2
            }
          },
          "init": 0
        }
      ],
      "protection": [
        {
          "var": "c",
          "lock": "m"
        }
      ],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::w1",
                "main::w2"
              ]
            },
            {
              "sid": "s2",
              "kind": "call",
              "func": "main::println",
              "args": [
                "\"DONE done=1\""
              ]
            },
            {
              "sid": "s3",
              "kind": "return"
            }
          ]
        },
        {
          "name": "w1",
          "kind": "normal",
          "form": "closure",
          "locals": [
            {
              "name": "cur",
              "type": "Int",
              "base": {
                "Int": {
                  "min": 0,
                  "max": 2
                }
              }
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "read_shared",
              "resource": "main::c",
              "dst": "cur"
            },
            {
              "sid": "s3",
              "kind": "branch",
              "cond": "cur == 0",
              "then": "s4",
              "else": "s5"
            },
            {
              "sid": "s4",
              "kind": "write_shared",
              "resource": "main::c",
              "expr": "cur + 1"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
          "name": "w2",
          "kind": "normal",
          "form": "closure",
          "locals": [
            {
              "name": "cur",
              "type": "Int",
              "base": {
                "Int": {
                  "min": 0,
                  "max": 2
                }
              }
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "read_shared",
              "resource": "main::c",
              "dst": "cur"
            },
            {
              "sid": "s3",
              "kind": "branch",
              "cond": "cur == 0",
              "then": "s4",
              "else": "s5"
            },
            {
              "sid": "s4",
              "kind": "write_shared",
              "resource": "main::c",
              "expr": "cur + 1"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
