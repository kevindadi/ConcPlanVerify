{
  "program": "notify_all_multi_waiter",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "m",
          "cv",
          "g12",
          "gN",
          "ready"
        ],
        "functions": [
          "main",
          "w1",
          "w2",
          "notifier",
          "println"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "m",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "cv",
          "kind": "sync",
          "type": "Condvar",
          "mode": "Sync"
        },
        {
          "name": "g12",
          "kind": "sync",
          "type": "Semaphore",
          "mode": "Sync",
          "count": 0
        },
        {
          "name": "gN",
          "kind": "sync",
          "type": "Semaphore",
          "mode": "Sync",
          "count": 0
        },
        {
          "name": "ready",
          "kind": "var",
          "type": "Var",
          "base": "Bool",
          "init": false
        }
      ],
      "protection": [
        {
          "var": "ready",
          "lock": "m"
        }
      ],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::w1",
                "main::w2",
                "main::notifier"
              ]
            },
            {
              "sid": "s2",
              "kind": "call",
              "func": "main::println",
              "args": [
                "\"DONE waiters=0\""
              ]
            },
            {
              "sid": "s3",
              "kind": "return"
            }
          ]
        },
        {
          "name": "w1",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "semaphore_release",
              "resource": "main::g12"
            },
            {
              "sid": "s3",
              "kind": "branch",
              "cond": "ready == true",
              "then": "s6",
              "else": "s4"
            },
            {
              "sid": "s4",
              "kind": "condvar_wait",
              "condvar": "main::cv",
              "lock": "main::m"
            },
            {
              "sid": "s5",
              "kind": "goto",
              "target": "s3"
            },
            {
              "sid": "s6",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s7",
              "kind": "semaphore_release",
              "resource": "main::gN"
            },
            {
              "sid": "s8",
              "kind": "return"
            }
          ]
        },
        {
          "name": "w2",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "semaphore_release",
              "resource": "main::g12"
            },
            {
              "sid": "s3",
              "kind": "branch",
              "cond": "ready == true",
              "then": "s6",
              "else": "s4"
            },
            {
              "sid": "s4",
              "kind": "condvar_wait",
              "condvar": "main::cv",
              "lock": "main::m"
            },
            {
              "sid": "s5",
              "kind": "goto",
              "target": "s3"
            },
            {
              "sid": "s6",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s7",
              "kind": "semaphore_release",
              "resource": "main::gN"
            },
            {
              "sid": "s8",
              "kind": "return"
            }
          ]
        },
        {
          "name": "notifier",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "semaphore_acquire",
              "resource": "main::g12"
            },
            {
              "sid": "s2",
              "kind": "semaphore_acquire",
              "resource": "main::g12"
            },
            {
              "sid": "s3",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s4",
              "kind": "write_shared",
              "resource": "main::ready",
              "expr": "true"
            },
            {
              "sid": "s5",
              "kind": "condvar_notify_all",
              "condvar": "main::cv"
            },
            {
              "sid": "s6",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s7",
              "kind": "semaphore_acquire",
              "resource": "main::gN"
            },
            {
              "sid": "s8",
              "kind": "semaphore_acquire",
              "resource": "main::gN"
            },
            {
              "sid": "s9",
              "kind": "return"
            }
          ]
        },
        {
          "name": "println",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
