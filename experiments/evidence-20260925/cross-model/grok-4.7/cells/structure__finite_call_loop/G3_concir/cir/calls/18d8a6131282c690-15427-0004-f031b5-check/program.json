{
  "program": "finite_call_loop",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "again"
        ],
        "functions": [
          "main",
          "helper",
          "println"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "again",
          "kind": "var",
          "type": "Var",
          "base": "Bool",
          "init": true
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "call",
              "func": "main::helper"
            },
            {
              "sid": "s2",
              "kind": "branch",
              "cond": "again == true",
              "then": "s3",
              "else": "s5"
            },
            {
              "sid": "s3",
              "kind": "write_shared",
              "resource": "main::again",
              "expr": "false"
            },
            {
              "sid": "s4",
              "kind": "goto",
              "target": "s1"
            },
            {
              "sid": "s5",
              "kind": "call",
              "func": "main::println",
              "args": [
                "\"DONE done=1\""
              ]
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
          "name": "helper",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "return"
            }
          ]
        },
        {
          "name": "println",
          "kind": "normal",
          "form": "closure",
          "params": [
            {
              "name": "msg",
              "type": "Int"
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
