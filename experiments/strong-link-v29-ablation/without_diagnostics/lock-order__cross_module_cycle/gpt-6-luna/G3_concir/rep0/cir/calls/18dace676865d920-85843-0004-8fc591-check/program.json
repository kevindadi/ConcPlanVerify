{
  "program": "ordered_two_resource_tasks",
  "version": "3.5.0",
  "entry": "first::main",
  "modules": [
    {
      "name": "first",
      "provides": {
        "resources": [
          "a",
          "done"
        ],
        "functions": [
          "t1",
          "main"
        ]
      },
      "requires": {
        "resources": [
          "second::b"
        ],
        "functions": [
          "second::t2"
        ]
      },
      "resources": [
        {
          "name": "a",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "done",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "t1",
          "kind": "normal",
          "form": "closure",
          "locals": [
            {
              "name": "work",
              "type": "Int",
              "modeled": true,
              "init": 0
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "first::a"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "second::b"
            },
            {
              "sid": "s3",
              "kind": "assign_local",
              "target": "work",
              "expr": "1"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "second::b"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "first::a"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
          "name": "main",
          "kind": "normal",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "first::t1",
                "second::t2"
              ]
            },
            {
              "sid": "s2",
              "kind": "write_shared",
              "resource": "first::done",
              "expr": "1"
            },
            {
              "sid": "s3",
              "kind": "return"
            }
          ]
        }
      ]
    },
    {
      "name": "second",
      "provides": {
        "resources": [
          "b"
        ],
        "functions": [
          "t2"
        ]
      },
      "requires": {
        "resources": [
          "first::a"
        ],
        "functions": []
      },
      "resources": [
        {
          "name": "b",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "t2",
          "kind": "normal",
          "form": "closure",
          "locals": [
            {
              "name": "work",
              "type": "Int",
              "modeled": true,
              "init": 0
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "first::a"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "second::b"
            },
            {
              "sid": "s3",
              "kind": "assign_local",
              "target": "work",
              "expr": "1"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "second::b"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "first::a"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
