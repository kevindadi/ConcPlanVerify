{
  "program": "condvar_waiters",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "m",
          "cv",
          "g12",
          "gN",
          "waiters",
          "out"
        ],
        "functions": [
          "main",
          "w1",
          "w2",
          "notifier"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "m",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "cv",
          "kind": "sync",
          "type": "Condvar",
          "mode": "Sync"
        },
        {
          "name": "g12",
          "kind": "sync",
          "type": "Semaphore",
          "mode": "Sync",
          "count": 0
        },
        {
          "name": "gN",
          "kind": "sync",
          "type": "Semaphore",
          "mode": "Sync",
          "count": 0
        },
        {
          "name": "waiters",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 2
        },
        {
          "name": "out",
          "kind": "var",
          "type": "Var",
          "base": "String",
          "init": ""
        }
      ],
      "protection": [
        {
          "var": "waiters",
          "lock": "m"
        }
      ],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::w1",
                "main::w2",
                "main::notifier"
              ]
            },
            {
              "sid": "s2",
              "kind": "write_shared",
              "resource": "main::out",
              "expr": "\"DONE waiters=0\""
            },
            {
              "sid": "s3",
              "kind": "return"
            }
          ]
        },
        {
          "name": "w1",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "semaphore_release",
              "resource": "main::g12",
              "count": 1
            },
            {
              "sid": "s3",
              "kind": "condvar_wait",
              "condvar": "main::cv",
              "lock": "main::m"
            },
            {
              "sid": "s4",
              "kind": "write_shared",
              "resource": "main::waiters",
              "expr": "waiters - 1"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s6",
              "kind": "semaphore_acquire",
              "resource": "main::gN",
              "count": 1
            },
            {
              "sid": "s7",
              "kind": "return"
            }
          ]
        },
        {
          "name": "w2",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "semaphore_release",
              "resource": "main::g12",
              "count": 1
            },
            {
              "sid": "s3",
              "kind": "condvar_wait",
              "condvar": "main::cv",
              "lock": "main::m"
            },
            {
              "sid": "s4",
              "kind": "write_shared",
              "resource": "main::waiters",
              "expr": "waiters - 1"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s6",
              "kind": "semaphore_acquire",
              "resource": "main::gN",
              "count": 1
            },
            {
              "sid": "s7",
              "kind": "return"
            }
          ]
        },
        {
          "name": "notifier",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "semaphore_acquire",
              "resource": "main::g12",
              "count": 2
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s3",
              "kind": "condvar_notify_all",
              "condvar": "main::cv"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s5",
              "kind": "semaphore_release",
              "resource": "main::gN",
              "count": 2
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
