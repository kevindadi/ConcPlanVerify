{
  "program": "sender_receiver",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "m",
          "ch",
          "progress",
          "done",
          "out"
        ],
        "functions": [
          "main",
          "sender",
          "receiver"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "m",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "ch",
          "kind": "sync",
          "type": "Channel",
          "mode": "Sync",
          "base": "Int",
          "capacity": 1
        },
        {
          "name": "progress",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        },
        {
          "name": "done",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        },
        {
          "name": "out",
          "kind": "var",
          "type": "Var",
          "base": "String",
          "init": ""
        }
      ],
      "protection": [
        {
          "var": "progress",
          "lock": "m"
        },
        {
          "var": "done",
          "lock": "m"
        },
        {
          "var": "out",
          "lock": "m"
        }
      ],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::sender",
                "main::receiver"
              ]
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s3",
              "kind": "write_shared",
              "resource": "main::done",
              "expr": "1"
            },
            {
              "sid": "s4",
              "kind": "write_shared",
              "resource": "main::out",
              "expr": "\"DONE done=1\""
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
          "name": "sender",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "write_shared",
              "resource": "main::progress",
              "expr": "progress + 1"
            },
            {
              "sid": "s3",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s4",
              "kind": "channel_send",
              "channel": "main::ch",
              "value": "1"
            },
            {
              "sid": "s5",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s6",
              "kind": "write_shared",
              "resource": "main::progress",
              "expr": "progress + 1"
            },
            {
              "sid": "s7",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s8",
              "kind": "channel_send",
              "channel": "main::ch",
              "value": "2"
            },
            {
              "sid": "s9",
              "kind": "return"
            }
          ]
        },
        {
          "name": "receiver",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "channel_recv",
              "channel": "main::ch",
              "dst": "first"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s3",
              "kind": "write_shared",
              "resource": "main::progress",
              "expr": "progress + 1"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s5",
              "kind": "channel_recv",
              "channel": "main::ch",
              "dst": "second"
            },
            {
              "sid": "s6",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s7",
              "kind": "write_shared",
              "resource": "main::progress",
              "expr": "progress + 1"
            },
            {
              "sid": "s8",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s9",
              "kind": "return"
            }
          ],
          "locals": [
            {
              "name": "first",
              "type": "Int"
            },
            {
              "name": "second",
              "type": "Int"
            }
          ]
        }
      ]
    }
  ]
}
