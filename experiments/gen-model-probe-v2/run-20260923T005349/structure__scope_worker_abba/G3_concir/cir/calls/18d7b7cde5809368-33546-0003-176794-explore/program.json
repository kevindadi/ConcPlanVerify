{
  "program": "two_mutex_ordered_workers",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "a",
          "b",
          "done"
        ],
        "functions": [
          "main",
          "w1",
          "w2"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "a",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "b",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "done",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        }
      ],
      "protection": [],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "scope",
              "funcs": [
                "main::w1",
                "main::w2"
              ]
            },
            {
              "sid": "s2",
              "kind": "write_shared",
              "resource": "main::done",
              "expr": "1"
            },
            {
              "sid": "s3",
              "kind": "return"
            }
          ]
        },
        {
          "name": "w1",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::a"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "main::b"
            },
            {
              "sid": "s3",
              "kind": "nop"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::b"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "main::a"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
          "name": "w2",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::a"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "main::b"
            },
            {
              "sid": "s3",
              "kind": "nop"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::b"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "main::a"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
