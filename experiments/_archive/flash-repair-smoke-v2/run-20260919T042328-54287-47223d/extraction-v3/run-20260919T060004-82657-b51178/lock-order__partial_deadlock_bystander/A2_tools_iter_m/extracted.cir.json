{
  "program": "semaphore_ordered_mutexes",
  "version": "cir-schema-v1",
  "entry": "main",
  "modules": [
    {
      "name": "main",
      "resources": [
        {
          "name": "mtx_a",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "mtx_b",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "sem_a",
          "kind": "sync",
          "type": "Semaphore",
          "mode": "Sync",
          "count": 1
        },
        {
          "name": "sem_b",
          "kind": "sync",
          "type": "Semaphore",
          "mode": "Sync",
          "count": 0
        },
        {
          "name": "stop_lock",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "stop_cv",
          "kind": "sync",
          "type": "Condvar",
          "mode": "Sync"
        },
        {
          "name": "stop_flag",
          "kind": "var",
          "type": "Var",
          "base": "Bool",
          "init": "false"
        }
      ],
      "functions": [
        {
          "name": "worker_a",
          "params": [],
          "body": [
            {
              "sid": "s1",
              "kind": "semaphore_acquire",
              "resource": "sem_a"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "mtx_a"
            },
            {
              "sid": "s3",
              "kind": "mutex_lock",
              "resource": "mtx_b"
            },
            {
              "sid": "s4",
              "kind": "semaphore_release",
              "resource": "sem_b"
            },
            {
              "sid": "s5",
              "kind": "mutex_unlock",
              "resource": "mtx_b"
            },
            {
              "sid": "s6",
              "kind": "mutex_unlock",
              "resource": "mtx_a"
            },
            {
              "sid": "s7",
              "kind": "return"
            }
          ]
        },
        {
          "name": "worker_b",
          "params": [],
          "body": [
            {
              "sid": "s8",
              "kind": "semaphore_acquire",
              "resource": "sem_b"
            },
            {
              "sid": "s9",
              "kind": "mutex_lock",
              "resource": "mtx_a"
            },
            {
              "sid": "s10",
              "kind": "mutex_lock",
              "resource": "mtx_b"
            },
            {
              "sid": "s11",
              "kind": "semaphore_release",
              "resource": "sem_a"
            },
            {
              "sid": "s12",
              "kind": "mutex_unlock",
              "resource": "mtx_b"
            },
            {
              "sid": "s13",
              "kind": "mutex_unlock",
              "resource": "mtx_a"
            },
            {
              "sid": "s14",
              "kind": "return"
            }
          ]
        },
        {
          "name": "bystander",
          "params": [],
          "body": [
            {
              "sid": "s15",
              "kind": "mutex_lock",
              "resource": "stop_lock"
            },
            {
              "sid": "s16",
              "kind": "read_shared",
              "resource": "stop_flag",
              "dst": "done"
            },
            {
              "sid": "s17",
              "kind": "branch",
              "cond": "done",
              "then": [
                {
                  "sid": "s18",
                  "kind": "mutex_unlock",
                  "resource": "stop_lock"
                },
                {
                  "sid": "s19",
                  "kind": "goto",
                  "target": "s26"
                }
              ],
              "else": [
                {
                  "sid": "s20",
                  "kind": "condvar_wait",
                  "condvar": "stop_cv",
                  "lock": "stop_lock"
                },
                {
                  "sid": "s21",
                  "kind": "read_shared",
                  "resource": "stop_flag",
                  "dst": "done"
                },
                {
                  "sid": "s22",
                  "kind": "branch",
                  "cond": "done",
                  "then": [
                    {
                      "sid": "s23",
                      "kind": "mutex_unlock",
                      "resource": "stop_lock"
                    },
                    {
                      "sid": "s24",
                      "kind": "goto",
                      "target": "s26"
                    }
                  ],
                  "else": [
                    {
                      "sid": "s25",
                      "kind": "mutex_unlock",
                      "resource": "stop_lock"
                    },
                    {
                      "sid": "s27",
                      "kind": "goto",
                      "target": "s15"
                    }
                  ]
                }
              ]
            },
            {
              "sid": "s26",
              "kind": "return"
            }
          ]
        },
        {
          "name": "main",
          "params": [],
          "body": [
            {
              "sid": "s28",
              "kind": "spawn",
              "func": "worker_a",
              "handle": "ha"
            },
            {
              "sid": "s29",
              "kind": "spawn",
              "func": "worker_b",
              "handle": "hb"
            },
            {
              "sid": "s30",
              "kind": "spawn",
              "func": "bystander",
              "handle": "hby"
            },
            {
              "sid": "s31",
              "kind": "join",
              "handle": "ha"
            },
            {
              "sid": "s32",
              "kind": "join",
              "handle": "hb"
            },
            {
              "sid": "s33",
              "kind": "mutex_lock",
              "resource": "stop_lock"
            },
            {
              "sid": "s34",
              "kind": "write_shared",
              "resource": "stop_flag",
              "expr": "true"
            },
            {
              "sid": "s35",
              "kind": "condvar_notify_all",
              "condvar": "stop_cv"
            },
            {
              "sid": "s36",
              "kind": "mutex_unlock",
              "resource": "stop_lock"
            },
            {
              "sid": "s37",
              "kind": "join",
              "handle": "hby"
            },
            {
              "sid": "s38",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
