{
  "program": "condvar_wait_notify",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "functions": [
        {
          "name": "main",
          "params": [],
          "body": [
            {
              "sid": "s1",
              "kind": "spawn",
              "func": "waiter",
              "handle": "h_waiter"
            },
            {
              "sid": "s2",
              "kind": "spawn",
              "func": "notifier",
              "handle": "h_notifier"
            },
            {
              "sid": "s3",
              "kind": "join",
              "handle": "h_waiter"
            },
            {
              "sid": "s4",
              "kind": "join",
              "handle": "h_notifier"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ],
          "kind": "normal"
        },
        {
          "name": "waiter",
          "params": [],
          "body": [
            {
              "sid": "s6",
              "kind": "mutex_lock",
              "resource": "mtx"
            },
            {
              "sid": "s7",
              "kind": "branch",
              "cond": "!*guard",
              "then": [
                {
                  "sid": "s8",
                  "kind": "condvar_wait",
                  "condvar": "cv",
                  "lock": "mtx"
                },
                {
                  "sid": "s9",
                  "kind": "goto",
                  "target": "s7"
                }
              ],
              "else": []
            },
            {
              "sid": "s10",
              "kind": "mutex_unlock",
              "resource": "mtx"
            },
            {
              "sid": "s11",
              "kind": "return"
            }
          ],
          "kind": "normal"
        },
        {
          "name": "notifier",
          "params": [],
          "body": [
            {
              "sid": "s12",
              "kind": "mutex_lock",
              "resource": "mtx"
            },
            {
              "sid": "s13",
              "kind": "write_shared",
              "resource": "ready",
              "expr": "true"
            },
            {
              "sid": "s14",
              "kind": "condvar_notify_all",
              "condvar": "cv"
            },
            {
              "sid": "s15",
              "kind": "mutex_unlock",
              "resource": "mtx"
            },
            {
              "sid": "s16",
              "kind": "return"
            }
          ],
          "kind": "normal"
        }
      ]
    }
  ]
}
