{
  "program": "rendezvous_condvar",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "resources": [
        {
          "name": "shared",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "cvar",
          "kind": "sync",
          "type": "Condvar",
          "mode": "Sync"
        },
        {
          "name": "tx1",
          "kind": "sync",
          "type": "Channel",
          "mode": "Sync",
          "base": "Int",
          "capacity": 0
        },
        {
          "name": "rx1",
          "kind": "sync",
          "type": "Channel",
          "mode": "Sync",
          "base": "Int",
          "capacity": 0
        }
      ],
      "functions": [
        {
          "name": "main",
          "params": [],
          "locals": [
            {
              "name": "s",
              "type": "Int"
            },
            {
              "name": "r",
              "type": "Int"
            }
          ],
          "body": [
            {
              "sid": "L1",
              "func": "main::sender",
              "handle": "s",
              "kind": "spawn"
            },
            {
              "sid": "L5",
              "func": "main::receiver",
              "handle": "r",
              "kind": "spawn"
            },
            {
              "sid": "L9",
              "handle": "s",
              "kind": "join"
            },
            {
              "sid": "L10",
              "handle": "r",
              "kind": "join"
            },
            {
              "sid": "s1",
              "kind": "return"
            }
          ],
          "kind": "normal"
        },
        {
          "name": "sender",
          "params": [],
          "locals": [
            {
              "name": "ready",
              "type": "Int"
            }
          ],
          "body": [
            {
              "sid": "L2",
              "resource": "main::shared",
              "kind": "mutex_lock"
            },
            {
              "sid": "s2",
              "resource": "main::shared",
              "expr": "true",
              "kind": "write_shared"
            },
            {
              "sid": "L3",
              "condvar": "main::cvar",
              "kind": "condvar_notify"
            },
            {
              "sid": "s3",
              "resource": "main::shared",
              "kind": "mutex_unlock"
            },
            {
              "sid": "L4",
              "channel": "main::tx1",
              "value": "1",
              "kind": "channel_send"
            },
            {
              "sid": "s4",
              "kind": "return"
            }
          ],
          "kind": "normal"
        },
        {
          "name": "receiver",
          "params": [],
          "locals": [
            {
              "name": "ready",
              "type": "Int"
            }
          ],
          "body": [
            {
              "sid": "L6",
              "resource": "main::shared",
              "kind": "mutex_lock"
            },
            {
              "sid": "s5",
              "cond": "!ready",
              "then": "s6",
              "else": "s7",
              "kind": "branch"
            },
            {
              "sid": "s6",
              "target": "L7",
              "kind": "goto"
            },
            {
              "sid": "s7",
              "target": "s8",
              "kind": "goto"
            },
            {
              "sid": "L7",
              "condvar": "main::cvar",
              "lock": "main::shared",
              "kind": "condvar_wait"
            },
            {
              "sid": "s8",
              "resource": "main::shared",
              "kind": "mutex_unlock"
            },
            {
              "sid": "L8",
              "channel": "main::rx1",
              "dst": "ready",
              "kind": "channel_recv"
            },
            {
              "sid": "s9",
              "kind": "return"
            }
          ],
          "kind": "normal"
        }
      ],
      "protection": []
    }
  ]
}
