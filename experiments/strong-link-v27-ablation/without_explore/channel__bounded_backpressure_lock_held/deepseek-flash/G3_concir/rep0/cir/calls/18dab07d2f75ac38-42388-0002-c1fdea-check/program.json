{
  "program": "sender_receiver_channel",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "m",
          "ch",
          "done"
        ],
        "functions": [
          "main",
          "sender",
          "receiver"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "m",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "ch",
          "kind": "sync",
          "type": "Channel",
          "mode": "Sync",
          "base": "Int",
          "capacity": 1
        },
        {
          "name": "done",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        }
      ],
      "protection": [
        {
          "var": "done",
          "lock": "m"
        }
      ],
      "functions": [
        {
          "name": "main",
          "kind": "normal",
          "body": [
            {
              "sid": "s1",
              "kind": "spawn",
              "func": "main::sender",
              "handle": "hs"
            },
            {
              "sid": "s2",
              "kind": "spawn",
              "func": "main::receiver",
              "handle": "hr"
            },
            {
              "sid": "s3",
              "kind": "join",
              "handle": "hs"
            },
            {
              "sid": "s4",
              "kind": "join",
              "handle": "hr"
            },
            {
              "sid": "s5",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s6",
              "kind": "write_shared",
              "resource": "main::done",
              "expr": "1"
            },
            {
              "sid": "s7",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s8",
              "kind": "return"
            }
          ]
        },
        {
          "name": "sender",
          "kind": "normal",
          "form": "closure",
          "locals": [
            {
              "name": "i",
              "type": "Int",
              "modeled": true,
              "init": 0
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "channel_send",
              "channel": "main::ch",
              "expr": "1"
            },
            {
              "sid": "s2",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s3",
              "kind": "assign_local",
              "target": "i",
              "expr": "i + 1"
            },
            {
              "sid": "s4",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s5",
              "kind": "channel_send",
              "channel": "main::ch",
              "expr": "2"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        },
        {
          "name": "receiver",
          "kind": "normal",
          "form": "closure",
          "locals": [
            {
              "name": "x",
              "type": "Int",
              "modeled": true,
              "init": 0
            },
            {
              "name": "y",
              "type": "Int",
              "modeled": true,
              "init": 0
            },
            {
              "name": "j",
              "type": "Int",
              "modeled": true,
              "init": 0
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s2",
              "kind": "assign_local",
              "target": "j",
              "expr": "j + 1"
            },
            {
              "sid": "s3",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s4",
              "kind": "channel_recv",
              "channel": "main::ch",
              "dst": "x"
            },
            {
              "sid": "s5",
              "kind": "mutex_lock",
              "resource": "main::m"
            },
            {
              "sid": "s6",
              "kind": "assign_local",
              "target": "j",
              "expr": "j + 1"
            },
            {
              "sid": "s7",
              "kind": "mutex_unlock",
              "resource": "main::m"
            },
            {
              "sid": "s8",
              "kind": "channel_recv",
              "channel": "main::ch",
              "dst": "y"
            },
            {
              "sid": "s9",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
