{
  "program": "worker_cycle",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [],
        "functions": [
          "main",
          "worker"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [],
      "protection": [],
      "functions": [
        {
          "name": "worker",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "return"
            }
          ]
        },
        {
          "name": "main",
          "kind": "normal",
          "locals": [
            {
              "name": "count",
              "type": "Int",
              "modeled": true,
              "init": 0
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "branch",
              "cond": "count < 1",
              "then": "s2",
              "else": "s6"
            },
            {
              "sid": "s2",
              "kind": "spawn",
              "func": "main::worker",
              "handle": "h"
            },
            {
              "sid": "s3",
              "kind": "join",
              "handle": "h"
            },
            {
              "sid": "s4",
              "kind": "assign_local",
              "target": "count",
              "expr": "count + 1"
            },
            {
              "sid": "s5",
              "kind": "goto",
              "target": "s1"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
