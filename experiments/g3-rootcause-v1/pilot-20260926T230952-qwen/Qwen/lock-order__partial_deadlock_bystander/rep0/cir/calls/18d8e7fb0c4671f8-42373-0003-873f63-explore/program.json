{
  "program": "handshake_workers",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "provides": {
        "resources": [
          "lock_a",
          "lock_b",
          "sem_a",
          "sem_b",
          "flag"
        ],
        "functions": [
          "main",
          "worker_a",
          "worker_b",
          "bystander"
        ]
      },
      "requires": {
        "resources": [],
        "functions": []
      },
      "resources": [
        {
          "name": "lock_a",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "lock_b",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "sem_a",
          "kind": "sync",
          "type": "Semaphore",
          "mode": "Sync",
          "count": 1
        },
        {
          "name": "sem_b",
          "kind": "sync",
          "type": "Semaphore",
          "mode": "Sync",
          "count": 1
        },
        {
          "name": "flag",
          "kind": "var",
          "type": "Var",
          "base": "Int",
          "init": 0
        }
      ],
      "protection": [
        {
          "var": "flag",
          "lock": "lock_a"
        }
      ],
      "functions": [
        {
          "name": "worker_a",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::lock_a"
            },
            {
              "sid": "s2",
              "kind": "semaphore_release",
              "resource": "main::sem_a"
            },
            {
              "sid": "s3",
              "kind": "semaphore_acquire",
              "resource": "main::sem_b"
            },
            {
              "sid": "s4",
              "kind": "mutex_lock",
              "resource": "main::lock_b"
            },
            {
              "sid": "s5",
              "kind": "write_shared",
              "resource": "main::flag",
              "expr": "1"
            },
            {
              "sid": "s6",
              "kind": "mutex_unlock",
              "resource": "main::lock_b"
            },
            {
              "sid": "s7",
              "kind": "mutex_unlock",
              "resource": "main::lock_a"
            },
            {
              "sid": "s8",
              "kind": "return"
            }
          ]
        },
        {
          "name": "worker_b",
          "kind": "normal",
          "form": "closure",
          "body": [
            {
              "sid": "s1",
              "kind": "mutex_lock",
              "resource": "main::lock_b"
            },
            {
              "sid": "s2",
              "kind": "semaphore_release",
              "resource": "main::sem_b"
            },
            {
              "sid": "s3",
              "kind": "semaphore_acquire",
              "resource": "main::sem_a"
            },
            {
              "sid": "s4",
              "kind": "mutex_lock",
              "resource": "main::lock_a"
            },
            {
              "sid": "s5",
              "kind": "read_shared",
              "resource": "main::flag"
            },
            {
              "sid": "s6",
              "kind": "mutex_unlock",
              "resource": "main::lock_a"
            },
            {
              "sid": "s7",
              "kind": "mutex_unlock",
              "resource": "main::lock_b"
            },
            {
              "sid": "s8",
              "kind": "return"
            }
          ]
        },
        {
          "name": "bystander",
          "kind": "normal",
          "form": "closure",
          "locals": [
            {
              "name": "i",
              "type": "Int",
              "modeled": true,
              "init": 0
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "assign_local",
              "target": "i",
              "expr": "i + 1"
            },
            {
              "sid": "s2",
              "kind": "goto",
              "target": "s1"
            }
          ]
        },
        {
          "name": "main",
          "kind": "normal",
          "locals": [
            {
              "name": "h_a",
              "type": "Int",
              "modeled": false,
              "init": 0
            },
            {
              "name": "h_b",
              "type": "Int",
              "modeled": false,
              "init": 0
            },
            {
              "name": "h_by",
              "type": "Int",
              "modeled": false,
              "init": 0
            }
          ],
          "body": [
            {
              "sid": "s1",
              "kind": "spawn",
              "func": "main::worker_a",
              "handle": "h_a"
            },
            {
              "sid": "s2",
              "kind": "spawn",
              "func": "main::worker_b",
              "handle": "h_b"
            },
            {
              "sid": "s3",
              "kind": "spawn",
              "func": "main::bystander",
              "handle": "h_by"
            },
            {
              "sid": "s4",
              "kind": "join",
              "handle": "h_a"
            },
            {
              "sid": "s5",
              "kind": "join",
              "handle": "h_b"
            },
            {
              "sid": "s6",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
