{
  "version": "cir-schema-v1",
  "contract": {
    "allowed_scope": [
      "functions",
      "modules",
      "allow_lock_reorder",
      "allow_statement_delete"
    ],
    "bounds": [
      "max_threads",
      "max_frames_per_thread",
      "max_states",
      "max_depth",
      "max_boundary_events"
    ],
    "predicates": {
      "and": {
        "required": [
          "kind",
          "predicates"
        ]
      },
      "channel_at_least": {
        "required": [
          "kind",
          "resource",
          "len"
        ]
      },
      "channel_empty": {
        "required": [
          "kind",
          "resource"
        ]
      },
      "false": {
        "required": [
          "kind"
        ]
      },
      "function_completed": {
        "required": [
          "kind",
          "function"
        ]
      },
      "mutex_free": {
        "required": [
          "kind",
          "resource"
        ]
      },
      "mutex_held": {
        "required": [
          "kind",
          "resource"
        ]
      },
      "not": {
        "required": [
          "kind",
          "predicate"
        ]
      },
      "or": {
        "required": [
          "kind",
          "predicates"
        ]
      },
      "true": {
        "required": [
          "kind"
        ]
      },
      "var_cmp": {
        "required": [
          "kind",
          "resource",
          "op",
          "value"
        ]
      },
      "var_eq": {
        "required": [
          "kind",
          "resource",
          "value"
        ]
      }
    },
    "preserved": {
      "always": {
        "required": [
          "kind",
          "description",
          "invariant"
        ]
      },
      "reachable": {
        "required": [
          "kind",
          "description",
          "goal"
        ]
      }
    },
    "properties": {
      "always_reachable": {
        "required": [
          "kind",
          "id",
          "goal"
        ]
      },
      "deadlock_free": {
        "required": [
          "kind",
          "id"
        ]
      },
      "reachability": {
        "required": [
          "kind",
          "id",
          "goal"
        ]
      },
      "safety": {
        "required": [
          "kind",
          "id",
          "invariant"
        ]
      },
      "unreachable": {
        "required": [
          "kind",
          "id",
          "bad"
        ]
      }
    }
  },
  "resources": {
    "Mutex": {
      "name": "mtx",
      "kind": "sync",
      "type": "Mutex",
      "mode": "Sync"
    },
    "Condvar": {
      "name": "cv",
      "kind": "sync",
      "type": "Condvar",
      "mode": "Sync"
    },
    "Var": {
      "name": "ready",
      "kind": "var",
      "type": "Var",
      "base": "bool",
      "init": "false"
    }
  },
  "statements": {
    "s0": {
      "kind": "spawn",
      "func": "waiter",
      "handle": "waiter"
    },
    "s1": {
      "kind": "spawn",
      "func": "notifier",
      "handle": "notifier"
    },
    "s2": {
      "kind": "join",
      "handle": "waiter"
    },
    "s3": {
      "kind": "join",
      "handle": "notifier"
    },
    "s4": {
      "kind": "mutex_lock",
      "resource": "mtx"
    },
    "s5": {
      "kind": "read_shared",
      "resource": "ready",
      "dst": "g"
    },
    "s6": {
      "kind": "branch",
      "cond": "!g",
      "then": [
        "s7"
      ],
      "else": [
        "s8"
      ]
    },
    "s7": {
      "kind": "condvar_wait",
      "condvar": "cv",
      "lock": "mtx"
    },
    "s8": {
      "kind": "mutex_unlock",
      "resource": "mtx"
    },
    "s9": {
      "kind": "mutex_lock",
      "resource": "mtx"
    },
    "s10": {
      "kind": "write_shared",
      "resource": "ready",
      "expr": "true"
    },
    "s11": {
      "kind": "condvar_notify_all",
      "condvar": "cv"
    },
    "s12": {
      "kind": "mutex_unlock",
      "resource": "mtx"
    }
  },
  "functions": {
    "main": {
      "params": [],
      "body": [
        "s0",
        "s1",
        "s2",
        "s3"
      ]
    },
    "waiter": {
      "params": [],
      "body": [
        "s4",
        "s5",
        "s6",
        "s7",
        "s8"
      ]
    },
    "notifier": {
      "params": [],
      "body": [
        "s9",
        "s10",
        "s11",
        "s12"
      ]
    }
  }
}
