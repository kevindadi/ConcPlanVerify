{
  "version": "cir-schema-v1",
  "contract": {
    "allowed_scope": [
      "functions",
      "modules",
      "allow_lock_reorder",
      "allow_statement_delete"
    ],
    "bounds": [
      "max_threads",
      "max_frames_per_thread",
      "max_states",
      "max_depth",
      "max_boundary_events"
    ],
    "predicates": {
      "and": {
        "required": [
          "kind",
          "predicates"
        ]
      },
      "channel_at_least": {
        "required": [
          "kind",
          "resource",
          "len"
        ]
      },
      "channel_empty": {
        "required": [
          "kind",
          "resource"
        ]
      },
      "false": {
        "required": [
          "kind"
        ]
      },
      "function_completed": {
        "required": [
          "kind",
          "function"
        ]
      },
      "mutex_free": {
        "required": [
          "kind",
          "resource"
        ]
      },
      "mutex_held": {
        "required": [
          "kind",
          "resource"
        ]
      },
      "not": {
        "required": [
          "kind",
          "predicate"
        ]
      },
      "or": {
        "required": [
          "kind",
          "predicates"
        ]
      },
      "true": {
        "required": [
          "kind"
        ]
      },
      "var_cmp": {
        "required": [
          "kind",
          "resource",
          "op",
          "value"
        ]
      },
      "var_eq": {
        "required": [
          "kind",
          "resource",
          "value"
        ]
      }
    },
    "preserved": {
      "always": {
        "required": [
          "kind",
          "description",
          "invariant"
        ]
      },
      "reachable": {
        "required": [
          "kind",
          "description",
          "goal"
        ]
      }
    },
    "properties": {
      "always_reachable": {
        "required": [
          "kind",
          "id",
          "goal"
        ]
      },
      "deadlock_free": {
        "required": [
          "kind",
          "id"
        ]
      },
      "reachability": {
        "required": [
          "kind",
          "id",
          "goal"
        ]
      },
      "safety": {
        "required": [
          "kind",
          "id",
          "invariant"
        ]
      },
      "unreachable": {
        "required": [
          "kind",
          "id",
          "bad"
        ]
      }
    }
  },
  "resources": {
    "Mutex": {
      "name": "mtx",
      "kind": "sync",
      "type": "Mutex",
      "mode": "Sync"
    },
    "Condvar": {
      "name": "cv",
      "kind": "sync",
      "type": "Condvar",
      "mode": "Sync"
    },
    "Var": {
      "name": "ready",
      "kind": "var",
      "type": "Var",
      "base": "bool",
      "init": "false"
    }
  },
  "functions": {
    "main": {
      "params": [],
      "body": [
        {
          "sid": "s1",
          "kind": "spawn",
          "func": "waiter",
          "handle": "waiter"
        },
        {
          "sid": "s2",
          "kind": "spawn",
          "func": "notifier",
          "handle": "notifier"
        },
        {
          "sid": "s3",
          "kind": "join",
          "handle": "waiter"
        },
        {
          "sid": "s4",
          "kind": "join",
          "handle": "notifier"
        },
        {
          "sid": "s5",
          "kind": "return"
        }
      ]
    },
    "waiter": {
      "params": [],
      "body": [
        {
          "sid": "s6",
          "kind": "mutex_lock",
          "resource": "mtx"
        },
        {
          "sid": "s7",
          "kind": "branch",
          "cond": "!ready",
          "then": [
            {
              "sid": "s8",
              "kind": "condvar_wait",
              "condvar": "cv",
              "lock": "mtx"
            },
            {
              "sid": "s9",
              "kind": "goto",
              "target": "s7"
            }
          ],
          "else": [
            {
              "sid": "s10",
              "kind": "mutex_unlock",
              "resource": "mtx"
            },
            {
              "sid": "s11",
              "kind": "return"
            }
          ]
        }
      ]
    },
    "notifier": {
      "params": [],
      "body": [
        {
          "sid": "s12",
          "kind": "mutex_lock",
          "resource": "mtx"
        },
        {
          "sid": "s13",
          "kind": "write_shared",
          "resource": "ready",
          "expr": "true"
        },
        {
          "sid": "s14",
          "kind": "condvar_notify_all",
          "condvar": "cv"
        },
        {
          "sid": "s15",
          "kind": "mutex_unlock",
          "resource": "mtx"
        },
        {
          "sid": "s16",
          "kind": "return"
        }
      ]
    }
  }
}
