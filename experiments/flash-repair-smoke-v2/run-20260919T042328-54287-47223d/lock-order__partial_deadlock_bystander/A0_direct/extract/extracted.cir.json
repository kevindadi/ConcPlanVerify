          "kind": "mutex_unlock",
          "resource": "mtx_a"
        },
        {
          "sid": "s18",
          "kind": "return"
        }
      ]
    },
    "worker_b": {
      "params": [
        "ma2",
        "mb2",
        "sa2",
        "sb2"
      ],
      "body": [
        {
          "sid": "s19",
          "kind": "mutex_lock",
          "resource": "mtx_b"
        },
        {
          "sid": "s20",
          "kind": "semaphore_release",
