        },
        {
          "sid": "s4",
          "kind": "assign_local",
          "target": "sem_b",
          "expr": "Arc::new(Semaphore::new(0))"
        },
        {
          "sid": "s5",
          "kind": "spawn",
          "func": "worker_a",
          "handle": "worker_a",
          "args": [
            "mtx_a",
            "mtx_b",
