        },
        {
          "sid": "s9",
          "kind": "join",
          "handle": "worker_b"
        },
        {
          "sid": "s10",
          "kind": "nop"
        },
        {
          "sid": "s11",
          "kind": "return"
        }
      ]
    },
    "worker_a": {
      "params": [
        "ma",
        "mb",
        "sa",
        "sb"
      ],
      "body": [
        {
          "sid": "s12",
          "kind": "mutex_lock",
          "resource": "mtx_a"
        },
        {
          "sid": "s13",
          "kind": "semaphore_release",
          "resource": "sem_a"
        },
        {
          "sid": "s14",
