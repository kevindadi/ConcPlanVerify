    "Semaphore::acquire": {
      "params": [
        "self"
      ],
      "body": [
        {
          "sid": "s28",
          "kind": "mutex_lock",
          "resource": "sem_permits"
        },
        {
          "sid": "s29",
          "kind": "branch",
          "cond": "*permits == 0",
          "then": [
            {
              "sid": "s30",
              "kind": "condvar_wait",
              "condvar": "sem_cv",
              "lock": "sem_permits"
            },
            {
              "sid": "s31",
              "kind": "goto",
              "target": "s29"
            }
          ],
          "else": [
            {
              "sid": "s32",
              "kind": "assign_local",
              "target": "*permits",
              "expr": "*permits - 1"
            },
            {
              "sid": "s33",
              "kind": "mutex_unlock",
              "resource": "sem_permits"
            },
            {
              "sid": "s34",
              "kind": "return"
            }
          ]
        }
      ]
    },
    "Semaphore::release": {
      "params": [
        "self"
      ],
      "body": [
        {
          "sid": "s35",
          "kind": "mutex_lock",
          "resource": "sem_permits"
        },
        {
          "sid": "s36",
          "kind": "assign_local",
          "target": "*permits",
          "expr": "*permits + 1"
        },
        {
          "sid": "s37",
          "kind": "mutex_unlock",
          "resource": "sem_permits"
        },
        {
          "sid": "s38",
          "kind": "condvar_notify",
          "condvar": "sem_cv"
        },
        {
          "sid": "s39",
          "kind": "return"
        }
      ]
