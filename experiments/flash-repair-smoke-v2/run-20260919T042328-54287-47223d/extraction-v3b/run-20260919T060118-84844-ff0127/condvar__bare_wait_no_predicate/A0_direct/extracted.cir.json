{
  "program": "condvar_wait_notify",
  "version": "3.5.0",
  "entry": "main::main",
  "modules": [
    {
      "name": "main",
      "resources": [
        {
          "name": "mtx",
          "kind": "sync",
          "type": "Mutex",
          "mode": "Sync"
        },
        {
          "name": "cv",
          "kind": "sync",
          "type": "Condvar",
          "mode": "Sync"
        },
        {
          "name": "ready",
          "kind": "var",
          "type": "Var",
          "base": "Bool",
          "init": "false"
        }
      ],
      "functions": [
        {
          "name": "main",
          "params": [],
          "body": [
            {
              "sid": "s1",
              "kind": "spawn",
              "func": "waiter",
              "handle": "h_waiter"
            },
            {
              "sid": "s2",
              "kind": "spawn",
              "func": "notifier",
              "handle": "h_notifier"
            },
            {
              "sid": "s3",
              "kind": "join",
              "handle": "h_waiter"
            },
            {
              "sid": "s4",
              "kind": "join",
              "handle": "h_notifier"
            },
            {
              "sid": "s5",
              "kind": "return"
            }
          ]
        },
        {
          "name": "waiter",
          "params": [],
          "body": [
            {
              "sid": "s6",
              "kind": "mutex_lock",
              "resource": "mtx"
            },
            {
              "sid": "s7",
              "kind": "read_shared",
              "resource": "ready",
              "dst": "g"
            },
            {
              "sid": "s8",
              "kind": "branch",
              "cond": "!g",
              "then": [
                {
                  "sid": "s9",
                  "kind": "condvar_wait",
                  "condvar": "cv",
                  "lock": "mtx"
                },
                {
                  "sid": "s10",
                  "kind": "goto",
                  "target": "s7"
                }
              ],
              "else": []
            },
            {
              "sid": "s11",
              "kind": "mutex_unlock",
              "resource": "mtx"
            },
            {
              "sid": "s12",
              "kind": "return"
            }
          ]
        },
        {
          "name": "notifier",
          "params": [],
          "body": [
            {
              "sid": "s13",
              "kind": "mutex_lock",
              "resource": "mtx"
            },
            {
              "sid": "s14",
              "kind": "write_shared",
              "resource": "ready",
              "expr": "true"
            },
            {
              "sid": "s15",
              "kind": "condvar_notify_all",
              "condvar": "cv"
            },
            {
              "sid": "s16",
              "kind": "mutex_unlock",
              "resource": "mtx"
            },
            {
              "sid": "s17",
              "kind": "return"
            }
          ]
        }
      ]
    }
  ]
}
