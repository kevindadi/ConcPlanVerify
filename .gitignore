# Python bytecode / caches
**/__pycache__/
*.pyc

# Plain-text logs / scratch output (never tracked), except archived tool
# evidence under experiments/ (stdout.txt/stderr.txt/exit.txt per call).
*.txt
!python/requirements.txt
!experiments/**/*.txt

# Local environment / secrets (never tracked)
.env
.venv

# Build output
target/

# Vendored third-party checkers (lockbud, Rudra). Pin by commit; build in place.
# Their raw evidence is archived under the experiment dirs, not here.
tools/

# Supplement build output (not tracked)
dist/

# Interactive working-tree snapshots (process records, not evidence)
reviews/

# Raw experiment tier (on disk + freeze tags only; see experiments/RAW_POLICY.md)
experiments/**/native-*.jsonl
experiments/**/miri-*.jsonl
experiments/**/traces/
experiments/**/monitor-traces/
experiments/**/conform-traces/
experiments/**/proj/
experiments/**/cir_trace.rs
experiments/**/concir_sync.rs
experiments/**/env.json
experiments/**/wall_ms.txt
experiments/**/exit.txt
experiments/**/build.stdout.txt
experiments/**/build.stderr.txt

# Supplement private word list (never tracked)
.supplement-private.json
