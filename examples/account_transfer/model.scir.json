                        ],
                        "updates_modeled": [
                          {
                            "target": "main::receipt_counter",
                            "expr": "receipt_counter + 1"
                          }
                        ],
                        "expected_type": "()",
                        "req": [
                          "R3",
                          "R4",
                          "R6"
                        ]
                      }
                    }
                  ]
                }
              ]
            },
