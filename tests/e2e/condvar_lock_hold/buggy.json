{
  "program": "condvar_lock_hold",
  "resources": [
    {"name": "outer", "kind": "sync", "type": "Mutex", "mode": "Sync"},
    {"name": "inner", "kind": "sync", "type": "Mutex", "mode": "Sync"},
    {"name": "cv", "kind": "sync", "type": "Condvar", "mode": "Sync"},
    {"name": "ready", "kind": "var", "type": "Var", "base": "Bool", "init": false}
  ],
  "protection": [{"var": "ready", "lock": "inner"}],
  "functions": [
    {
      "name": "main", "kind": "normal",
      "body": [
        {"sid": "s1", "op": ["spawn", "waiter"],   "transfer": ["next", "s2"]},
        {"sid": "s2", "op": ["spawn", "notifier"], "transfer": ["next", "s3"]},
        {"sid": "s3", "op": ["join", "waiter"],    "transfer": ["next", "s4"]},
        {"sid": "s4", "op": ["join", "notifier"],  "transfer": ["next", "s5"]},
        {"sid": "s5", "op": "return",              "transfer": "return"}
      ]
    },
    {
      "name": "waiter", "kind": "closure",
      "body": [
        {"sid": "s1", "op": ["res_op", "outer", "lock"],       "transfer": ["next", "s2"]},
        {"sid": "s2", "op": ["res_op", "inner", "lock"],       "transfer": ["next", "s3"]},
        {"sid": "s3", "op": ["res_op", "cv", "wait", "inner"], "transfer": ["next", "s4"]},
        {"sid": "s4", "op": ["res_op", "inner", "drop"],       "transfer": ["next", "s5"]},
        {"sid": "s5", "op": ["res_op", "outer", "drop"],       "transfer": ["next", "s6"]},
        {"sid": "s6", "op": "return",                           "transfer": "return"}
      ]
    },
    {
      "name": "notifier", "kind": "closure",
      "body": [
        {"sid": "s1", "op": ["res_op", "outer", "lock"],            "transfer": ["next", "s2"]},
        {"sid": "s2", "op": ["res_op", "inner", "lock"],            "transfer": ["next", "s3"]},
        {"sid": "s3", "op": ["res_op", "ready", "write", "true"],   "transfer": ["next", "s4"]},
        {"sid": "s4", "op": ["res_op", "cv", "notify_all"],         "transfer": ["next", "s5"]},
        {"sid": "s5", "op": ["res_op", "inner", "drop"],            "transfer": ["next", "s6"]},
        {"sid": "s6", "op": ["res_op", "outer", "drop"],            "transfer": ["next", "s7"]},
        {"sid": "s7", "op": "return",                                "transfer": "return"}
      ]
    }
  ],
  "entry": "main"
}
