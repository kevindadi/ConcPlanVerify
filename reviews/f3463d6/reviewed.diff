+fn outcome_of(src: &str) -> concir::sem::outcome::Outcome {
+    let spec: concir::explore::contract::ContractSpec = serde_json::from_str(
+        r#"{"name":"d","properties":[{"kind":"deadlock_free","id":"d"}]}"#,
+    )
