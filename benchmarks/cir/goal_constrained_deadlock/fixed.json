{
  "program": "goal_constrained_deadlock",
  "resources": [
    {"name": "m1", "kind": "sync", "type": "Mutex", "mode": "Sync"},
    {"name": "m2", "kind": "sync", "type": "Mutex", "mode": "Sync"},
    {"name": "flag", "kind": "var", "type": "Var", "base": "Int", "init": 0},
    {"name": "result", "kind": "var", "type": "Var", "base": "Int", "init": 0}
  ],
  "protection": [
    {"var": "result", "lock": "m1"}
  ],
  "functions": [
    {
      "name": "main", "kind": "normal",
      "body": [
        {"sid": "s1", "op": ["spawn", "w1"], "transfer": ["next", "s2"]},
        {"sid": "s2", "op": ["spawn", "w2"], "transfer": ["next", "s3"]},
        {"sid": "s3", "op": ["spawn", "w3"], "transfer": ["next", "s4"]},
        {"sid": "s4", "op": ["join", "w1"],  "transfer": ["next", "s5"]},
        {"sid": "s5", "op": ["join", "w2"],  "transfer": ["next", "s6"]},
        {"sid": "s6", "op": ["join", "w3"],  "transfer": ["next", "s7"]},
        {"sid": "s7", "op": "return",        "transfer": "return"}
      ]
    },
    {
      "name": "w1", "kind": "closure",
      "body": [
        {"sid": "s1", "op": ["res_op", "flag", "write", "1"], "transfer": ["next", "s2"]},
        {"sid": "s2", "op": ["res_op", "m1", "lock"],        "transfer": ["next", "s3"]},
        {"sid": "s3", "op": ["res_op", "m2", "lock"],        "transfer": ["next", "s4"]},
        {"sid": "s4", "op": ["res_op", "result", "write", "1"], "transfer": ["next", "s5"]},
        {"sid": "s5", "op": ["res_op", "m2", "drop"],        "transfer": ["next", "s6"]},
        {"sid": "s6", "op": ["res_op", "m1", "drop"],        "transfer": ["next", "s7"]},
        {"sid": "s7", "op": "return",                         "transfer": "return"}
      ]
    },
    {
      "name": "w2", "kind": "closure",
      "body": [
        {"sid": "s1", "op": ["res_op", "flag", "write", "2"], "transfer": ["next", "s2"]},
        {"sid": "s2", "op": ["res_op", "m1", "lock"],        "transfer": ["next", "s3"]},
        {"sid": "s3", "op": ["res_op", "m2", "lock"],        "transfer": ["next", "s4"]},
        {"sid": "s4", "op": ["res_op", "result", "write", "2"], "transfer": ["next", "s5"]},
        {"sid": "s5", "op": ["res_op", "m2", "drop"],        "transfer": ["next", "s6"]},
        {"sid": "s6", "op": ["res_op", "m1", "drop"],        "transfer": ["next", "s7"]},
        {"sid": "s7", "op": "return",                         "transfer": "return"}
      ]
    },
    {
      "name": "w3", "kind": "closure",
      "body": [
        {"sid": "s1", "op": ["res_op", "flag", "write", "3"], "transfer": ["next", "s2"]},
        {"sid": "s2", "op": ["res_op", "flag", "read"],
         "transfer": ["branch", "flag == 3", "s3", "s7"]},
        {"sid": "s3", "op": ["res_op", "m1", "lock"],           "transfer": ["next", "s4"]},
        {"sid": "s4", "op": ["res_op", "result", "write", "3"], "transfer": ["next", "s5"]},
        {"sid": "s5", "op": ["res_op", "m1", "drop"],           "transfer": ["next", "s6"]},
        {"sid": "s6", "op": "return",                            "transfer": "return"},
        {"sid": "s7", "op": ["res_op", "m1", "lock"],           "transfer": ["next", "s8"]},
        {"sid": "s8", "op": ["res_op", "m2", "lock"],           "transfer": ["next", "s9"]},
        {"sid": "s9", "op": ["res_op", "result", "write", "99"], "transfer": ["next", "s10"]},
        {"sid": "s10", "op": ["res_op", "m2", "drop"],          "transfer": ["next", "s11"]},
        {"sid": "s11", "op": ["res_op", "m1", "drop"],          "transfer": ["next", "s12"]},
        {"sid": "s12", "op": "return",                           "transfer": "return"}
      ]
    }
  ],
  "entry": "main",
  "goals": [
    {
      "id": "g_result_special",
      "desc": "Business payload: some schedule must observe result == 99",
      "marking": {},
      "variables": {"result": 99}
    }
  ]
}
